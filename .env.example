# Tipo de banco de dados: "mysql" ou "postgres"
DB_CLIENT=mysql

# Dados de conexão do banco
DB_HOST=localhost
DB_USER=admin
DB_PASSWORD=troque-esta-senha
DB_NAME=crud_nodejs
DB_PORT=3306

# Segredo usado para assinar os tokens JWT de autenticação.
# Gere um valor aleatório forte, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo

# Porta em que o servidor HTTP vai escutar
PORT=5000

# development | production
NODE_ENV=development

# ---- Opcionais ----

# Duração do login, em horas (padrão: 8)
# SESSION_HOURS=8

# Quantos proxies existem na frente do app (Vercel, nginx...). Necessário para o limite de
# tentativas enxergar o IP real. Na Vercel isso já é detectado sozinho. Sem proxy, deixe 0.
# TRUST_PROXY=0

# Tamanho do pool de conexões com o banco (padrão: 10). Em serverless prefira um valor baixo (2 a 5).
# DB_POOL_SIZE=10
